# ==============================================================================
# Multi-Agent Architectures for Autonomous Data Analytics - Environment Variables
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# LLM Provider API Keys (Set at least one, or use Ollama for local inference)
# 1. Google Gemini (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# 3. Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. Local Ollama (Default host when running via Docker is host.docker.internal)
OLLAMA_BASE_URL=http://localhost:11434
